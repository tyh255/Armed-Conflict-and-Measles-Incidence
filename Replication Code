# ####### S10: first-difference SEM #######
#
# Differencing within country sweeps out time-invariant confounders. Same
# structure as Model A, just on first differences.

semds_diff <- semds_std %>%
  arrange(country.code, year) %>%
  group_by(country.code) %>%
  mutate(
    d_wb_measles_incidence_z  = wb_measles_incidence_z  - lag(wb_measles_incidence_z),
    d_gdp_per_capita_z        = gdp_per_capita_z        - lag(gdp_per_capita_z),
    d_life_expectancy_z       = life_expectancy_z       - lag(life_expectancy_z),
    d_mean_years_schooling_z  = mean_years_schooling_z  - lag(mean_years_schooling_z),
    d_battle_deaths_z         = battle_deaths_z         - lag(battle_deaths_z),
    d_displaced_pct_z         = displaced_pct_z         - lag(displaced_pct_z)
  ) %>%
  ungroup() %>%
  filter(!is.na(d_battle_deaths_z))

model_diff <- '
  dSocioEcon =~ d_gdp_per_capita_z + d_life_expectancy_z + d_mean_years_schooling_z
  dSocioEcon ~ d_displaced_pct_z + d_battle_deaths_z
  d_displaced_pct_z ~ d_battle_deaths_z
  d_wb_measles_incidence_z ~ dSocioEcon + d_battle_deaths_z + d_displaced_pct_z
'

diff_results <- extract_sem_results(model_diff, "S10_FirstDiff", semds_diff,
                                    cluster_var = "country.code")

print(diff_results$std_solution, n = Inf)
write.csv(diff_results$std_solution,
          "./results/S10_FirstDifference_SEM.csv", row.names = FALSE)


# ####### S11: extended (0-3 yr) lag SEM + Wald tests #######
#
# Pushes the lag horizon out to three years to check the lag-1 result in B/D
# isn't masking effects at a longer horizon. The two Wald tests at the end
# check joint significance of all four battle-deaths terms on measles.

semds_std1 <- semds_std %>%
  group_by(country.code) %>%
  arrange(year) %>%
  mutate(
    battle_deaths_z_lag2 = lag(battle_deaths_z, 2),
    battle_deaths_z_lag3 = lag(battle_deaths_z, 3)
  ) %>%
  ungroup()

# E = case counts (Model AA in the paper)
model_E <- '
  SocioEcon =~ gdp_per_capita_z + life_expectancy_z + mean_years_schooling_z
  SocioEcon ~ displaced_pct_z + battle_deaths_z + battle_deaths_z_lag1 +
              battle_deaths_z_lag2 + battle_deaths_z_lag3
  displaced_pct_z ~ battle_deaths_z + battle_deaths_z_lag1 +
                    battle_deaths_z_lag2 + battle_deaths_z_lag3
  wb_measles_incidence_z ~ SocioEcon + battle_deaths_z + battle_deaths_z_lag1 +
                           battle_deaths_z_lag2 + battle_deaths_z_lag3
'

# F = incidence rate (Model BB in the paper)
model_F <- '
  SocioEcon =~ gdp_per_capita_z + life_expectancy_z + mean_years_schooling_z
  SocioEcon ~ displaced_pct_z + battle_deaths_z + battle_deaths_z_lag1 +
              battle_deaths_z_lag2 + battle_deaths_z_lag3
  displaced_pct_z ~ battle_deaths_z + battle_deaths_z_lag1 +
                    battle_deaths_z_lag2 + battle_deaths_z_lag3
  wb_measles_incidence_rate_1M_z ~ SocioEcon + battle_deaths_z + battle_deaths_z_lag1 +
                                   battle_deaths_z_lag2 + battle_deaths_z_lag3
'

lag_models <- list(mE = model_E, mF = model_F)
lag_results <- imap(lag_models, ~ extract_sem_results(.x, .y, semds_std1))
table_s11   <- make_wide_table(lag_results)

print(table_s11, n = Inf, width = Inf)
write.csv(table_s11, "./results/S11_ExtendedLag_SEM.csv", row.names = FALSE)

# Refit with labeled coefficients so we can constrain them in the Wald test.
model_E_labeled <- '
  SocioEcon =~ gdp_per_capita_z + life_expectancy_z + mean_years_schooling_z
  SocioEcon ~ displaced_pct_z + battle_deaths_z + battle_deaths_z_lag1 +
              battle_deaths_z_lag2 + battle_deaths_z_lag3
  displaced_pct_z ~ battle_deaths_z + battle_deaths_z_lag1 +
                    battle_deaths_z_lag2 + battle_deaths_z_lag3
  wb_measles_incidence_z ~ SocioEcon +
    l0*battle_deaths_z + l1*battle_deaths_z_lag1 +
    l2*battle_deaths_z_lag2 + l3*battle_deaths_z_lag3
'

fit_E_wald <- sem(model_E_labeled, data = semds_std1,
                  missing = "fiml", estimator = "MLR",
                  cluster = "country.code", std.lv = TRUE)

wald_E <- lavTestWald(fit_E_wald, constraints = "l0==0\nl1==0\nl2==0\nl3==0")
cat("\n--- Wald: Model E (cases, lags 0-3 jointly) ---\n")
print(wald_E)

model_F_labeled <- '
  SocioEcon =~ gdp_per_capita_z + life_expectancy_z + mean_years_schooling_z
  SocioEcon ~ displaced_pct_z + battle_deaths_z + battle_deaths_z_lag1 +
              battle_deaths_z_lag2 + battle_deaths_z_lag3
  displaced_pct_z ~ battle_deaths_z + battle_deaths_z_lag1 +
                    battle_deaths_z_lag2 + battle_deaths_z_lag3
  wb_measles_incidence_rate_1M_z ~ SocioEcon +
    r0*battle_deaths_z + r1*battle_deaths_z_lag1 +
    r2*battle_deaths_z_lag2 + r3*battle_deaths_z_lag3
'

fit_F_wald <- sem(model_F_labeled, data = semds_std1,
                  missing = "fiml", estimator = "MLR",
                  cluster = "country.code", std.lv = TRUE)

wald_F <- lavTestWald(fit_F_wald, constraints = "r0==0\nr1==0\nr2==0\nr3==0")
cat("\n--- Wald: Model F (rate, lags 0-3 jointly) ---\n")
print(wald_F)

cat("\nDone. Output CSVs are in ./results/\n")
