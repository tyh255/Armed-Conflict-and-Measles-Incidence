# Replication code for Headley & Tozan, "The Association of Armed Conflict
# with Global Measles Cases: A Structural Equation Modeling Analysis of
# 193 Countries from 2000 to 2023." PLOS Medicine.
#
# Reproduces:
#   - Table 2 (country FE panels, 20 specs)
#   - Table 3 (main SEMs, Models A-D)
#   - S10 (first-difference SEM)
#   - S11 (3-year lag SEM with joint Wald tests)
#
# Expected inputs in ./data/:
#   vaccination_thresholds.csv
#   WHO Measles Incidence.csv
#   WHO_Measles Case Incidence_Per Million.csv
#   IHME Measles Incidence.csv
#   hdr-data.csv
#   WB_Health Expenditures.csv
#   WB_TB Incidence Rate.csv
#   UNHCR_persons_of_concern.csv


library(dplyr)
library(tidyr)
library(tidyverse)
library(lavaan)
library(semTools)
library(purrr)
library(plm)
library(lmtest)


####### Data prep #######

# Base panel: vaccination coverage collapsed to one row per country-year.
semds <- read.csv('./data/vaccination_thresholds.csv')

semds <- semds %>%
  group_by(Country, Country.Code, Year) %>%
  summarise(
    mean_coverage    = mean(Coverage, na.rm = TRUE),
    MCV1             = mean(Coverage[vaccine == "MCV1"], na.rm = TRUE),
    MCV2             = mean(Coverage[vaccine == "MCV2"], na.rm = TRUE),
    GDP_per_capita   = first(GDP_per_capita),
    bd_best          = first(bd_best),
    intensity_level  = first(intensity_level),
    Population       = first(Population),
    displaced_pct    = first(displaced_pct_new)
  ) %>%
  ungroup()

# WHO measles case counts. Country labels differ from our key, so patch by hand
# before joining.
who_measles <- read.csv('./data/WHO Measles Incidence.csv')

who_measles$Country...Region[who_measles$Country...Region == "Côte d'Ivoire"]         <- "Cote d'Ivoire"
who_measles$Country...Region[who_measles$Country...Region == "occupied Palestinian territory, including east Jerusalem"] <- "State of Palestine"
who_measles$Country...Region[who_measles$Country...Region == "Türkiye"]               <- "Turkiye"
who_measles$Country...Region[who_measles$Country...Region == "United Kingdom of Great Britain and Northern Ireland"] <- "United Kingdom"
who_measles$Country...Region[who_measles$Country...Region == "United States of America"] <- "United States"

who_measles_long <- who_measles %>%
  pivot_longer(cols = starts_with("X"), names_to = "Year", values_to = "Incidence") %>%
  mutate(Year = as.integer(str_extract(Year, "\\d{4}")),
         Incidence = as.numeric(str_remove(Incidence, ",")))
colnames(who_measles_long)[c(1, 3, 4)] <- c("Country", "Year", "Incidence")

semds <- semds %>%
  left_join(who_measles_long %>% select(Country, Year, Incidence), by = c("Country", "Year"))

# Same WHO source but the per-million rate (used as the outcome in Models C/D).
who_measles_i <- read.csv('./data/WHO_Measles Case Incidence_Per Million.csv')

who_measles_i$Country...Region[who_measles_i$Country...Region == "Côte d'Ivoire"]    <- "Cote d'Ivoire"
who_measles_i$Country...Region[who_measles_i$Country...Region == "occupied Palestinian territory, including east Jerusalem"] <- "State of Palestine"
who_measles_i$Country...Region[who_measles_i$Country...Region == "Türkiye"]          <- "Turkiye"
who_measles_i$Country...Region[who_measles_i$Country...Region == "United Kingdom of Great Britain and Northern Ireland"] <- "United Kingdom"
who_measles_i$Country...Region[who_measles_i$Country...Region == "United States of America"] <- "United States"

who_measles_long_i <- who_measles_i %>%
  mutate(across(starts_with("X"), as.character)) %>%
  pivot_longer(cols = starts_with("X"), names_to = "Year", values_to = "Incidence_Rate_1M") %>%
  mutate(Year = as.integer(str_extract(Year, "\\d{4}")),
         Incidence_Rate_1M = as.numeric(Incidence_Rate_1M))
colnames(who_measles_long_i)[c(1, 3, 4)] <- c("Country", "Year", "Incidence_Rate_1M")

semds <- semds %>%
  left_join(who_measles_long_i %>% select(Country, Year, Incidence_Rate_1M),
            by = c("Country", "Year"), relationship = "many-to-many")

# IHME estimates — kept around as a cross-check on the WHO numbers.
ihme_measles <- read.csv('./data/IHME Measles Incidence.csv')

ihme_measles$location_name[ihme_measles$location_name == "Côte d'Ivoire"]            <- "Cote d'Ivoire"
ihme_measles$location_name[ihme_measles$location_name == "Palestine"]                <- "State of Palestine"
ihme_measles$location_name[ihme_measles$location_name == "Turkey"]                   <- "Turkiye"
ihme_measles$location_name[ihme_measles$location_name == "United States of America"] <- "United States"

ihme_wide <- ihme_measles %>%
  filter(age_name == "All ages", sex_name == "Both", measure_name == "Incidence") %>%
  select(location_name, year, metric_name, val) %>%
  pivot_wider(names_from = metric_name, values_from = val)

semds <- semds %>%
  left_join(ihme_wide, by = c("Country" = "location_name", "Year" = "year"))

# HDI: life expectancy + mean years of schooling. Together with GDP these form
# the latent SocioEcon construct downstream.
hdi <- read.csv('./data/hdr-data.csv')

hdi_wide <- hdi %>%
  select(countryIsoCode, year, indicatorCode, value) %>%
  pivot_wider(names_from = indicatorCode, values_from = value)

semds <- semds %>%
  left_join(hdi_wide, by = c("Country.Code" = "countryIsoCode", "Year" = "year"))

# World Bank: health spending (% of GDP) and TB incidence. TB is only used as a
# robustness covariate.
wbh <- read.csv('./data/WB_Health Expenditures.csv')
wbh <- wbh[wbh$Series.Name == "Current health expenditure (% of GDP)", ]

wbh_long <- wbh %>%
  pivot_longer(cols = starts_with("X"), names_to = "Year", values_to = "health_exp_gdp") %>%
  mutate(Year = as.integer(gsub("X([0-9]{4}).*", "\\1", Year)),
         health_exp_gdp = as.numeric(health_exp_gdp)) %>%
  select(Country.Code, Year, health_exp_gdp)

wbtb <- read.csv('./data/WB_TB Incidence Rate.csv')

wbtb_long <- wbtb %>%
  pivot_longer(cols = starts_with("X"), names_to = "Year", values_to = "tb_incidence") %>%
  mutate(Year = as.integer(gsub("X([0-9]{4}).*", "\\1", Year)),
         tb_incidence = as.numeric(tb_incidence)) %>%
  select(Country.Code, Year, tb_incidence)

semds <- semds %>%
  left_join(wbh_long,  by = c("Country.Code", "Year")) %>%
  left_join(wbtb_long, by = c("Country.Code", "Year"))

# UNHCR persons of concern. We sum the four categories and express as a share
# of population.
un_disp <- read.csv('./data/UNHCR_persons_of_concern.csv')
un_disp$New_Displacement_Total <- un_disp$Refugees + un_disp$Asylum.seekers +
  un_disp$IDPs + un_disp$Others.of.concern
un_disp <- un_disp %>% rename(Country.Code = Country.of.Origin.ISO)

semds <- semds %>%
  left_join(un_disp %>% select(Country.Code, Year, New_Displacement_Total),
            by = c("Country.Code", "Year"))
semds$displaced_pct_new <- semds$New_Displacement_Total / semds$Population

# Trim to the columns we actually use and give them tidier names.
semds_subset <- semds %>%
  select(
    country.code                 = Country.Code,
    year                         = Year,
    mean_coverage,
    total_displacement           = New_Displacement_Total,
    gdp_per_capita               = GDP_per_capita,
    battle_deaths                = bd_best,
    population                   = Population,
    displaced_pct                = displaced_pct_new,
    wb_measles_incidence         = Incidence,
    wb_measles_incidence_rate_1M = Incidence_Rate_1M,
    ihme_measles_incidence       = Number,
    ihme_measles_rate            = Rate,
    life_expectancy              = le,
    mean_years_schooling         = mys,
    health_portion_gdp           = health_exp_gdp,
    MCV1,
    wb_tb_incidence              = tb_incidence
  ) %>%
  distinct(country.code, year, .keep_all = TRUE)

# Scale everything. Counts get log1p first because they're hugely right-skewed
# — battle deaths in particular: most country-years are zero, a handful are in
# the six figures.
semds_std <- semds_subset %>%
  mutate(
    across(
      c(total_displacement, gdp_per_capita, battle_deaths,
        population, wb_measles_incidence, wb_measles_incidence_rate_1M,
        ihme_measles_incidence, wb_tb_incidence),
      ~ scale(log1p(.x))[, 1],
      .names = "{.col}_z"
    ),
    across(
      c(displaced_pct, ihme_measles_rate, life_expectancy,
        mean_years_schooling, health_portion_gdp, mean_coverage, MCV1),
      ~ scale(.x)[, 1],
      .names = "{.col}_z"
    )
  )

# One-year lags for the lagged-conflict specifications.
semds_std <- semds_std %>%
  group_by(country.code) %>%
  arrange(year, .by_group = TRUE) %>%
  mutate(
    battle_deaths_z_lag1                   = dplyr::lag(battle_deaths_z, 1),
    wb_incidence_z_lag1                    = dplyr::lag(wb_measles_incidence_z, 1),
    wb_measles_incidence_rate_1M_z_lag1    = dplyr::lag(wb_measles_incidence_rate_1M_z, 1),
    displaced_pct_lag1                     = dplyr::lag(displaced_pct_z, 1)
  ) %>%
  ungroup()


####### SEM helpers #######

# Fit a model and pull out what we actually want for the tables: standardized
# coefs with 95% CIs and p-values, plus the usual robust fit indices. Pass a
# cluster variable to get cluster-robust SEs (needed for the FD model).
extract_sem_results <- function(model_syntax, model_name, data,
                                cluster_var = NULL) {
  fit <- sem(
    model_syntax,
    data      = data,
    missing   = "fiml",
    estimator = "MLR",
    std.lv    = TRUE,
    cluster   = cluster_var,
    control   = list(iter.max = 500)
  )

  std_solution <- standardizedSolution(fit, type = "std.all", se = TRUE, ci = TRUE) %>%
    filter(op %in% c("~", "=~")) %>%
    mutate(
      p_fmt   = ifelse(pvalue < 0.001, "p < 0.001", sprintf("p = %.3f", pvalue)),
      est_str = sprintf("%.3f [%.3f, %.3f], %s", est.std, ci.lower, ci.upper, p_fmt),
      model   = model_name
    ) %>%
    select(model, Path = lhs, Relation = op, Predictor = rhs, `Estimate [95% CI], p` = est_str)

  fit_idx <- fitMeasures(fit, c("cfi.robust", "tli.robust", "rmsea.robust", "srmr", "aic", "bic"))

  fit_df <- tibble::tibble(
    model    = model_name,
    fit_type = names(fit_idx),
    fit_value = round(fit_idx, 3)
  )

  list(fit_object = fit, std_solution = std_solution, fit_df = fit_df)
}


# Stack several model results side-by-side for the manuscript tables.
make_wide_table <- function(results_list) {
  coef_wide <- bind_rows(map(results_list, "std_solution")) %>%
    unite("Effect", Path, Relation, Predictor, sep = " ") %>%
    pivot_wider(names_from = model, values_from = `Estimate [95% CI], p`)

  fit_wide <- bind_rows(map(results_list, "fit_df")) %>%
    pivot_wider(names_from = model, values_from = fit_value) %>%
    rename(Effect = fit_type) %>%
    mutate(across(everything(), as.character))

  bind_rows(coef_wide, fit_wide)
}


####### Table 3: main SEMs #######
#
# A / C: contemporaneous battle deaths only.
# B / D: add a 1-year lag.
# A / B use measles case counts; C / D use the per-million incidence rate.

model_A <- '
  SocioEcon =~ gdp_per_capita_z + life_expectancy_z + mean_years_schooling_z
  SocioEcon ~ displaced_pct_z + battle_deaths_z
  displaced_pct_z ~ battle_deaths_z
  wb_measles_incidence_z ~ SocioEcon + battle_deaths_z + displaced_pct_z
'

model_B <- '
  SocioEcon =~ gdp_per_capita_z + life_expectancy_z + mean_years_schooling_z
  SocioEcon ~ displaced_pct_z + battle_deaths_z + battle_deaths_z_lag1
  displaced_pct_z ~ battle_deaths_z + battle_deaths_z_lag1
  battle_deaths_z ~ battle_deaths_z_lag1
  wb_measles_incidence_z ~ SocioEcon + battle_deaths_z + displaced_pct_z + battle_deaths_z_lag1
'

model_C <- '
  SocioEcon =~ gdp_per_capita_z + life_expectancy_z + mean_years_schooling_z
  SocioEcon ~ displaced_pct_z + battle_deaths_z
  displaced_pct_z ~ battle_deaths_z
  wb_measles_incidence_rate_1M_z ~ SocioEcon + battle_deaths_z + displaced_pct_z
'

model_D <- '
  SocioEcon =~ gdp_per_capita_z + life_expectancy_z + mean_years_schooling_z
  SocioEcon ~ displaced_pct_z + battle_deaths_z + battle_deaths_z_lag1
  displaced_pct_z ~ battle_deaths_z + battle_deaths_z_lag1
  battle_deaths_z ~ battle_deaths_z_lag1
  wb_measles_incidence_rate_1M_z ~ SocioEcon + battle_deaths_z + displaced_pct_z + battle_deaths_z_lag1
'

primary_models <- list(A = model_A, B = model_B, C = model_C, D = model_D)

primary_results <- imap(primary_models, ~ extract_sem_results(.x, .y, semds_std))
table_3         <- make_wide_table(primary_results)

print(table_3, n = Inf, width = Inf)
write.csv(table_3, "./results/Table3_Primary_SEM.csv", row.names = FALSE)


# ####### Table 2: country fixed-effects panels #######
#
# 20 specs across four outcomes (GDP, displacement, battle deaths, measles)
# with varying covariate sets. All within-country FE, Arellano-style
# cluster-robust SEs.

# pull one (coef, CI, p) cell out as a formatted string
extract_fe_cell <- function(model, var) {
  if (!var %in% names(coef(model))) return(NA_character_)

  vcov_r <- plm::vcovHC(model, method = "arellano", type = "HC1", cluster = "group")
  ct     <- lmtest::coeftest(model, vcov. = vcov_r)
  ci     <- lmtest::coefci(model,   vcov. = vcov_r)

  sprintf("%.2f [%.2f, %.2f], p = %.2f",
          ct[var, "Estimate"],
          ci[var, 1], ci[var, 2],
          ct[var, "Pr(>|t|)"])
}

run_fe <- function(dv, ivs, data) {
  f <- as.formula(paste(dv, "~", paste(ivs, collapse = " + ")))
  plm(f, data = data, index = c("country.code", "year"),
      model = "within", effect = "individual")
}

# shorthands
bd     <- "battle_deaths_z";      bd_lag <- "battle_deaths_z_lag1"
displ  <- "displaced_pct_z";      gdp    <- "gdp_per_capita_z"
cov    <- "mean_coverage_z";      measles <- "wb_measles_incidence_z"

fe_models <- list(
  M1  = run_fe(gdp,     c(bd),                          semds_std),
  M2  = run_fe(gdp,     c(bd_lag),                      semds_std),
  M3  = run_fe(gdp,     c(bd, displ),                   semds_std),
  M4  = run_fe(gdp,     c(bd, displ, cov),               semds_std),
  M5  = run_fe(gdp,     c(bd, bd_lag, displ, cov),       semds_std),
  M6  = run_fe(displ,   c(bd),                          semds_std),
  M7  = run_fe(displ,   c(bd_lag),                      semds_std),
  M8  = run_fe(displ,   c(bd, gdp),                     semds_std),
  M9  = run_fe(displ,   c(bd, gdp, cov),                semds_std),
  M10 = run_fe(displ,   c(bd, bd_lag, gdp, cov),         semds_std),
  M11 = run_fe(bd,      c(bd_lag),                      semds_std),
  M12 = run_fe(bd,      c(displ),                       semds_std),
  M13 = run_fe(bd,      c(bd_lag, displ, gdp),           semds_std),
  M14 = run_fe(bd,      c(bd_lag, displ, gdp, cov),      semds_std),
  M15 = run_fe(measles, c(bd),                          semds_std),
  M16 = run_fe(measles, c(bd_lag),                      semds_std),
  M17 = run_fe(measles, c(bd, displ),                   semds_std),
  M18 = run_fe(measles, c(bd, displ, gdp),               semds_std),
  M19 = run_fe(measles, c(bd, displ, gdp, cov),          semds_std),
  M20 = run_fe(measles, c(bd, bd_lag, displ, gdp, cov),  semds_std)
)

col_vars <- c(bd, bd_lag, displ, gdp, cov)
col_labs <- c("BRDs", "BRDs (lagged)", "Population displacement",
              "GDP per Capita", "Mean Vaccination Coverage")

table_2 <- data.frame(Model = paste0("Model ", 1:20))
for (i in seq_along(col_vars)) {
  table_2[[col_labs[i]]] <- sapply(fe_models, extract_fe_cell, var = col_vars[i])
}

print(table_2)
